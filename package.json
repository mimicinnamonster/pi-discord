{
  "name": "pi-discord",
  "version": "1.0.0",
  "description": "Standalone Discord bot for pi coding agent",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:debug": "DISCORD_DEBUG=true bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "dev:debug": "DISCORD_DEBUG=true bun --watch run src/index.ts",
    "build": "bun run tsc",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.2",
    "discord.js": "^14.26.3",
    "pi-mcp-adapter": "^2.4.2"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
}
