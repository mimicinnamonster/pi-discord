{
  "name": "pi-discord",
  "version": "1.0.0",
  "description": "Standalone Discord bot for pi coding agent",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:debug": "DISCORD_DEBUG=true bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "dev:debug": "DISCORD_DEBUG=true bun --watch run src/index.ts",
    "build": "bun run tsc",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.67.5",
    "discord.js": "^14.26.2"
  },
  "patch": {
    "@mariozechner/pi-ai@npm:0.67.5": [
      "./patches/@mariozechner%2Fpi-ai@0.67.5.patch"
    ]
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "patchedDependencies": {
    "@mariozechner/pi-ai@0.67.5": "patches/@mariozechner%2Fpi-ai@0.67.5.patch"
  }
}
