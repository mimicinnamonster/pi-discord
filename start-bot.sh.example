#!/bin/zsh
# Launch wrapper for pi-discord bot
# Copy to start-bot.sh and customize paths

# Set the project directory
PROJECT_DIR="/PATH/TO/pi-discord"

# Locate bun - adjust to your installation
# Common locations: /opt/homebrew/bin/bun, ~/.bun/bin/bun, or use mise
BUN_PATH="/opt/homebrew/bin/bun"

# Source shell configurations for environment setup
[[ -f ~/.zshrc ]] && source ~/.zshrc
[[ -f ~/.zprofile ]] && source ~/.zprofile
[[ -f ~/.zshenv ]] && source ~/.zshenv

# Ensure DISCORD_BOT_TOKEN is available (can be set in .zshenv or exported here)
# export DISCORD_BOT_TOKEN="your-token-here"

# Change to project directory
cd "$PROJECT_DIR" || { echo "Error: Project directory not found at $PROJECT_DIR"; exit 1; }

# Run the bot
exec "$BUN_PATH" run start:debug 2>&1 1>> "$PROJECT_DIR/logs.txt"
